<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\AIIntegratedServer\**\*"
          Exclude="..\AIIntegratedServer\.python311\**\*;..\AIIntegratedServer\.venv\**\*;..\AIIntegratedServer\.venv311\**\*;..\AIIntegratedServer\.venv314\**\*;..\AIIntegratedServer\.runtime\**\*;..\AIIntegratedServer\models\**\*;..\AIIntegratedServer\__pycache__\**\*;..\AIIntegratedServer\*.log;..\AIIntegratedServer\*.download;..\AIIntegratedServer\*.pt;..\AIIntegratedServer\*api_token*.txt;..\AIIntegratedServer\*api_key*.txt"
          Link="AIIntegratedServer\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Community\*.png" />
    <EmbeddedResource Include="Assets\Community\*.png">
      <LogicalName>ImageEditor.CommunityAssets.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.7.0.20230115" />
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.7.0.20230115" />
    <PackageReference Include="MySql.Data" Version="26.7.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Models\RealESR-AnimeVideo-v3_x4.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="Assets\Fonts\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Update="Models\real_esrgan_x4plus.data">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Models\real_esrgan_x4plus.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
